# ============================================================
# 平安产险数据湖BI项目 - 部署配置
# 换机器只需修改此文件，无需改脚本
# ============================================================

# --- 服务器连接 ---
REMOTE_HOST="192.168.1.100"
REMOTE_USER="openclaw"
REMOTE_PORT=22

# --- 远程基础目录 ---
REMOTE_BASE_DIR="/home/openclaw/.openclaw"

# --- 各模块目录（可自定义，换机器改这里） ---
SKILLS_DIR="${REMOTE_BASE_DIR}/skills"
BIN_DIR="${REMOTE_BASE_DIR}/bin"
WORKSPACE_DIR="${REMOTE_BASE_DIR}/workspace"
DDL_DIR="${WORKSPACE_DIR}/ddl"          # DWD/DWS/ADS层DDL（ODS由flink-cdc自动创建）
DWD_DIR="${WORKSPACE_DIR}/dwd"          # DWD层ETL脚本
DWS_DIR="${WORKSPACE_DIR}/dws"          # DWS层ETL脚本

# --- MySQL连接（用于init_mysql.sh） ---
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
# MYSQL_PASSWORD 请通过环境变量设置，不要在此文件中写明文密码
#   PowerShell: $env:MYSQL_PASSWORD="your_password"
#   Bash:       export MYSQL_PASSWORD="your_password"
MYSQL_PASSWORD="${MYSQL_PASSWORD:-}"
MYSQL_DATABASE="pingan_insurance"

# --- RAG向量索引 ---
RAG_INDEX_DIR="${SKILLS_DIR}/rag/indices"
RAG_MAX_CACHED_MODELS=1

# --- Python环境 ---
PYTHON_BIN="python3"
PIP_BIN="pip3"
