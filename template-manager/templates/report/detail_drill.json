    {"name": "level_3", "label": "三级维度", "type": "string", "optional": true}
  ],
  "metrics": [
    {"name": "amount", "label": "金额", "type": "decimal", "aggregation": "SUM"},
    {"name": "count", "label": "数量", "type": "bigint", "aggregation": "COUNT"},
    {"name": "avg_value", "label": "均值", "type": "decimal", "aggregation": "AVG", "optional": true}
